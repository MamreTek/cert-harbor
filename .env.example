CERT_HARBOR_ENV=development
CERT_HARBOR_PORT=8080
CERT_HARBOR_DEMO=0
CERT_HARBOR_FIXTURE_PATH=examples/demo-fixture.json
CERT_HARBOR_DATA_PATH=data/cert-harbor.json
CERT_HARBOR_ALERTS_PATH=data/cert-harbor-alerts.json
CERT_HARBOR_NOTIFICATIONS_PATH=data/cert-harbor-notifications.json
CERT_HARBOR_DATABASE_URL=
CERT_HARBOR_SYNC_INTERVAL=24h

# Docker Compose defaults. Change the password before any shared deployment.
POSTGRES_DB=cert_harbor
POSTGRES_USER=cert_harbor
POSTGRES_PASSWORD=cert_harbor_local_only

# Required when CERT_HARBOR_ENV=production. Never commit real values.
CERT_HARBOR_ADMIN_TOKEN=
CERT_HARBOR_VIEWER_TOKEN=
CERT_HARBOR_ENCRYPTION_KEY=
